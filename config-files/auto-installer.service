[Unit]
Description=Automatic Installation Service
After=multi-user.target systemd-user-sessions.service network.target
Before=getty@tty1.service
Conflicts=getty@tty1.service
ConditionKernelCommandLine=autoinstall=true
Wants=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/auto-installer
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
KillMode=process

[Install]
WantedBy=multi-user.target